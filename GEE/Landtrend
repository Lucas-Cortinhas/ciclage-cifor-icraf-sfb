exports.landtrend = function(x){
    
   
   var temp_SentCol = ee.Algorithms.TemporalSegmentation.LandTrendr(x);
     
     
     var segmentationInforaw = temp_SentCol.select("LandTrendr");
     
     
     var segmentationInfo = ee.Image.cat(segmentationInforaw.arraySlice(0,0,1).add(1),
                                         segmentationInforaw.arraySlice(0,1,4)).toArray(0).rename("LandTrendr");
     
     return segmentationInfo; 

};

exports.landtrendImage = function(segmentationInfo,band, minMag){
  
  minMag = minMag || 0;
  
  var fitted = segmentationInfo.arraySlice(0, 2, 3);
  var vertexMask = segmentationInfo.arraySlice(0, 3, 4); // slice out the 'Is Vertex' row - yes(1)/no(0)
  var vertices = segmentationInfo.arrayMask(vertexMask);
  
  var left = vertices.arraySlice(1, 0, -1);    // slice out the vertices as the start of segments
  var right = vertices.arraySlice(1, 1, null); // slice out the vertices as the end of segments
  var startYear = left.arraySlice(0, 0, 1);    // get year dimension of LT data from the segment start vertices
  var startVal = left.arraySlice(0, 2, 3);     // get spectral index dimension of LT data from the segment start vertices
  var endYear = right.arraySlice(0, 0, 1);     // get year dimension of LT data from the segment end vertices 
  var endVal = right.arraySlice(0, 2, 3);
  
  var dur = endYear.subtract(startYear);       // subtract the segment start year from the segment end year to calculate the duration of segments 
  var mag = endVal.subtract(startVal);         // substract the segment start index value from the segment end index value to calculate the delta of segments
  var rate = mag.divide(dur); 
  
  var segInfo = ee.Image.cat([startYear, endYear, startVal, endVal, mag, dur, rate])
  .toArray(0).mask(vertexMask.mask());
  
  
  var sortByThis = segInfo.arraySlice(0, 1, 2).toArray(0).multiply(-1);
  //var sortByThis = segInfo.arraySlice(0,4,5).toArray(0).multiply(-1); // need to flip the delta here, since arraySort is working by ascending order
  var segInfoSorted = segInfo.arraySort(sortByThis); // sort the array by magnitude
  var bigDelta = segInfoSorted.arraySlice(1, 0, 1);
  
  var distDir = 1;
  
  var yod      = bigDelta.arraySlice(0,0,1).arrayProject([1]).arrayFlatten([['yod_'+band]]);
  var endYr    = bigDelta.arraySlice(0,1,2).arrayProject([1]).arrayFlatten([['endYr_'+band]]);
  var startV   = bigDelta.arraySlice(0,2,3).arrayProject([1]).arrayFlatten([['startVal_'+band]]).multiply(distDir);
  var endV     = bigDelta.arraySlice(0,3,4).arrayProject([1]).arrayFlatten([['endVal_'+band]]).multiply(distDir);
  var magImg   = bigDelta.arraySlice(0,4,5).arrayProject([1]).arrayFlatten([['mag_'+band]]).multiply(distDir);
  var durImg   = bigDelta.arraySlice(0,5,6).arrayProject([1]).arrayFlatten([['dur_'+band]]);
  var rateImg  = bigDelta.arraySlice(0,6,7).arrayProject([1]).arrayFlatten([['rate_'+band]]).multiply(distDir);

  // ----- FILTRO DE RUÍDO -----
  // onde |mag| < minMag, força "constante": mag=0, rate=0, endVal=startVal
  var isNoise = magImg.abs().lt(minMag);

  magImg  = magImg.where(isNoise, 0);
  rateImg = rateImg.where(isNoise, 0);
  endV    = endV.where(isNoise, startV);

  var bigDeltaImg = ee.Image.cat(yod, endYr, startV, endV, magImg, durImg, rateImg);
  return bigDeltaImg;
}