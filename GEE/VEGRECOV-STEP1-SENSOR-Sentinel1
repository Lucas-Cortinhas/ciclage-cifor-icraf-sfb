// =================================================================================
// MODULE: SENTINEL-1 SAR PRE-PROCESSING
// =================================================================================
// DESIGN DECISIONS:
//   - DESCENDING orbit only: avoids geometric inconsistency from mixing look angles.
//   - Speckle filter applied in LINEAR scale: averaging in dB is mathematically
//     incorrect. We convert to linear, apply focal mean, then return to dB.
//   - CpR computed in linear scale: VH_lin / VV_lin captures the physical ratio
//     of volume-to-surface scattering. This is preferable to the dB difference
//     (VH_dB - VV_dB) when used as a regression input.
//   - VH_dB retained as a second index: directly tracks canopy backscatter volume
//     and provides CCDC/LandTrendr with an independent signal from CpR.
// =================================================================================

exports.processSAR = function(PROC_AOI, START_DATE, END_DATE, SAR_INDICES) {

  // ── 1. Collection Filtering ─────────────────────────────────────────────────
  // Restrict to Interferometric Wide (IW) swath mode, dual-polarization,
  // and DESCENDING pass for geometric consistency across the time series.
  var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
    .filterBounds(PROC_AOI)
    .filterDate(START_DATE, END_DATE)
    .filter(ee.Filter.eq('instrumentMode', 'IW'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
    .filter(ee.Filter.eq('orbitProperties_pass', 'DESCENDING'));

  // ── 2. Speckle Filtering in Linear Scale ────────────────────────────────────
  // SAR imagery contains multiplicative speckle noise. Filtering must be applied
  // in linear (power) scale, not dB, to preserve radiometric integrity.
  // A 5x5 focal mean balances speckle suppression with spatial resolution retention.
    
  var applySpeckleFilter = function(img) {

    // Convert dB to linear power scale for each polarization channel.
    var vv_linear = ee.Image(10).pow(img.select('VV').divide(10));
    var vh_linear = ee.Image(10).pow(img.select('VH').divide(10));

    // Apply 5x5 focal mean in linear scale (radius=2 pixels ≈ 5x5 kernel at 10m).
    var vv_filt = vv_linear.focal_mean({radius: 2, kernelType: 'square', units: 'pixels'});
    var vh_filt = vh_linear.focal_mean({radius: 2, kernelType: 'square', units: 'pixels'});

    // ── 3. CpR Computation (in linear scale, before dB conversion) ───────────
    // CpR = VH_lin / VV_lin.
    // This ratio isolates volume-scattering dominance (vegetation canopy) from
    // surface/double-bounce returns. It increases as woody biomass accumulates.
    // Clamped to [0, 1] to suppress geometric noise at very low VV returns.
    var cpr = vh_filt.divide(vv_filt).clamp(0, 1).rename('CpR');

    // ── 4. Return to dB Scale ─────────────────────────────────────────────────
    // Convert filtered linear values back to dB for temporal analysis.
    // dB scale compresses the dynamic range and linearises the relationship
    // with vegetation structure parameters.
    var vv_db = vv_filt.log10().multiply(10).rename('VV_dB');
    var vh_db = vh_filt.log10().multiply(10).rename('VH_dB');
    

    return img
      .addBands(vv_db)
      .addBands(vh_db)
      .addBands(cpr)
      .copyProperties(img, ['system:time_start']);
  };

  // Execute pre-processing pipeline and return only the requested SAR indices.
  return s1.map(applySpeckleFilter).select(SAR_INDICES);
  
};