// =============================================================================
// 1. CONFIGURAÇÃO GERAL 
// =============================================================================
Map.setOptions('SATELLITE');
 
var lTrain = 'base_samples-v10';
var export_anual = false; // exporta composições anuais também, se true
 
// Campo usado para identificar cada polígono
var type = "id";
 
// Lista de IDs a processar.
var idList = Amazonia.aggregate_array(type).distinct().getInfo();
print('IDs que serão processados:', idList);
print('Total de polígonos:', idList.length);
 
//Tempo de Interesse:
var START_DATE = ee.Date('2019-01-01');
var END_DATE   = ee.Date('2026-01-01');
 
var INTV_START_DATE_RAW = START_DATE;
var intvMonth  = INTV_START_DATE_RAW.get('month');
var intvDay    = INTV_START_DATE_RAW.get('day');
var endYearNum = END_DATE.get('year');
var provisionalEndDate = ee.Date.fromYMD(endYearNum, intvMonth, intvDay);
var INTV_END_DATE = ee.Date(
  ee.Algorithms.If(
    provisionalEndDate.difference(END_DATE, 'day').gt(0),
    provisionalEndDate.advance(-1, 'year'),
    provisionalEndDate
  )
);
 
//Índices 
var OPTICAL_INDICES = ["NBR","EVI","NDRE","SAVI","MSI"];
var SAR_INDICES = ['CpR'];
var ALL_INDICES = OPTICAL_INDICES.concat(SAR_INDICES);
var LT_INDEX = ALL_INDICES;
 
// Parâmetros do LandTrendr
var M_segments   = 2;
var S_Threshold  = 0.1;
var Overshoot    = 3;
var Recovery     = false;
var R_thershold  = 1;
var P_threshold  = 0.5;
var Model_prop   = 2.5;
var observation  = 2;
 
var VISUAL_INDEX = 'EVI';
 
//----- Parâmetros gerais
var CLOUD_PROB_THRESH = 30;
var HARMONIC_FREQ = 1;
var TARGET_SEGMENT = -1;
 
var MIN_MAG = {
  NBR: 0.03, EVI: 0.03, NDRE: 0.03, SAVI: 0.03, MSI: 0.03, NDVI: 0.03, CpR: 0.5
};
 
//----- Limiares da regra de classificação
var photogain    = 0.70;
var photoDecline = 0.50;
var soil         = 0.30;
 
// =============================================================================
// 2. IMPORTAÇÃO DE MÓDULOS (uma vez só)
// =============================================================================
var modCovariates = require('users/lucascortinhas19/CICLAGE:VEGRECOV-STEP1-COVARIATES');
var modS2         = require('users/lucascortinhas19/CICLAGE:VEGRECOV-STEP1-SENSOR-Sentinel2');
var modS1         = require('users/lucascortinhas19/CICLAGE:VEGRECOV-STEP1-SENSOR-Sentinel1');
var lt            = require('users/lucascortinhas19/CICLAGE:Landtrend');
 
// =============================================================================
// 3. TREINO DO CLASSIFICADOR RF 
// =============================================================================
var final_samples = ee.FeatureCollection('users/lucascortinhas19/' + lTrain);
 
// Nomes de banda esperados (mesmos para qualquer polígono, pois vêm dos índices)
var expectedBandNames = ee.List(
  ['mag_', 'rate_', 'startVal_', 'endVal_'].reduce(function(acc, prefix) {
    ALL_INDICES.forEach(function(idx) { acc.push(prefix + idx); });
    return acc;
  }, [])
);
 
var classifier = ee.Classifier.smileRandomForest(100).setOutputMode('PROBABILITY').train({
  features: final_samples,
  classProperty: 'class',
  inputProperties: expectedBandNames
});
 
// =============================================================================
// 4. FUNÇÃO PRINCIPAL
// =============================================================================
function processarPoligono(id) {
 
  // ---- 4.1 Área de interesse do polígono atual
  var AOIf = ee.FeatureCollection([Amazonia.filter(ee.Filter.eq(type, id)).first()]);
 
  var AOI = AOIf.geometry();
  var PROC_AOI = AOI.buffer(30).bounds();
 
  // ---- 4.2 Ingestão de dados
  var topoData   = modCovariates.exportTopography(PROC_AOI);
  var precipBase = modCovariates.exportPrecipitation(AOI, START_DATE, END_DATE);
 
  var s2Processed = modS2.processOptical(PROC_AOI, START_DATE, END_DATE,
                      CLOUD_PROB_THRESH, OPTICAL_INDICES);
  var s1Processed = modS1.processSAR(PROC_AOI, START_DATE, END_DATE, SAR_INDICES);
 
  var SIndexOpticalRaw = s2Processed.select(OPTICAL_INDICES).sort('system:time_start');
  var SIndexSARRaw     = s1Processed.select(SAR_INDICES).sort('system:time_start');
 
  // ---- 4.3 Composição 10 dias
  var totalDays    = END_DATE.difference(START_DATE, 'day');
  var timeSequence = ee.List.sequence(0, totalDays.subtract(1), 10);
 
  var make10DayComposite = function(rawCollection) {
    return ee.ImageCollection.fromImages(
      timeSequence.map(function(dayOffset) {
        var tStart = START_DATE.advance(dayOffset, 'day');
        var tEnd   = tStart.advance(10, 'day');
        var window = rawCollection.filterDate(tStart, tEnd);
        return window.median()
          .set('system:time_start', tStart.millis())
          .set('image_count',       window.size());
      })
    ).filter(ee.Filter.gt('image_count', 0));
  };
 
  var SIndexOptical = make10DayComposite(SIndexOpticalRaw);
  var SIndexSAR     = make10DayComposite(SIndexSARRaw);
 
  // ---- 4.4 Fusão óptico + SAR
  var sensorFusionFilter = ee.Filter.maxDifference({
    difference:  35 * 24 * 60 * 60 * 1000,
    leftField:  'system:time_start',
    rightField: 'system:time_start'
  });
  var saveBestSAR = ee.Join.saveBest({ matchKey: 'sar_match', measureKey: 'time_diff' });
 
  var SIndex = ee.ImageCollection(saveBestSAR.apply(SIndexOptical, SIndexSAR, sensorFusionFilter))
    .map(function(img) {
      var sarImg = ee.Image(img.get('sar_match'));
      var sarBands = ee.Algorithms.If(
        sarImg,
        sarImg.select(SAR_INDICES),
        ee.Image.constant(0).rename(SAR_INDICES[0])
      );
      return img.addBands(sarBands).set('sar_match', null);
    });
 
  // ---- 4.5 Composições anuais
  var startYearNum = ee.Date(START_DATE).get('year');
  var endYearNum2   = ee.Date(END_DATE).get('year');
  var years = ee.List.sequence(startYearNum, endYearNum2);
 
  var annualy = ee.ImageCollection.fromImages(
    years.map(function(year) {
      return SIndex.filter(ee.Filter.calendarRange(year, year, 'year'))
        .median()
        .set('year', year)
        .set('system:time_start', ee.Date.fromYMD(year, 1, 1).millis());
    })
  );
 
  // ---- 4.6 LandTrendr por índice
  var LandTrend_img = ee.Image.cat(
    ALL_INDICES.map(function(index) {
      var ltResult = lt.landtrend({
        timeSeries: annualy.select([index]),
        maxSegments: M_segments,
        spikeThreshold: S_Threshold,
        vertexCountOvershoot: Overshoot,
        preventOneYearRecovery: Recovery,
        recoveryThreshold: R_thershold,
        pvalThreshold: P_threshold,
        bestModelProportion: Model_prop,
        minObservationsNeeded: observation
      });
      return lt.landtrendImage(ltResult, index, MIN_MAG[index]);
    })
  );
 
  LandTrend_img = LandTrend_img.select(['mag_.*','rate_.*','startVal_.*','endVal_.*']);
 
  // ---- 4.7 Classificação
  var classification = LandTrend_img.classify(classifier);
 
  var Photosynthesis = ee.Image(0)
    .where(classification.select('classification').lt(soil), 0)
    .where(classification.select('classification').gte(soil).and(classification.select('classification').lt(photoDecline)), 1)
    .where(classification.select('classification').gte(photoDecline).and(classification.select('classification').lt(photogain)), 2)
    .where(classification.select('classification').gte(photogain), 3)
    .rename('classification');
 
  var newimage = Photosynthesis.reproject({
    crs: Photosynthesis.projection(),
    scale: 10
  });
 
  // ---- 4.8 Zona UTM local dinâmica
  var centroid = AOI.centroid();
  var lon = ee.Number(centroid.coordinates().get(0));
  var lat = ee.Number(centroid.coordinates().get(1));
 
  var zoneNumber = lon.add(180).divide(6).floor().add(1);
  var isSouth = lat.lt(0);
 
  var utmEpsg = ee.Algorithms.If({
    condition: isSouth,
    trueCase: ee.String('EPSG:327').cat(zoneNumber.format('%02d')),
    falseCase: ee.String('EPSG:326').cat(zoneNumber.format('%02d'))
  });
 
  var utmPoint = centroid.transform(utmEpsg, 0.001);
  var xOrigin = ee.Number(utmPoint.coordinates().get(0)).divide(10).round().multiply(10);
  var yOrigin = ee.Number(utmPoint.coordinates().get(1)).divide(10).round().multiply(10);
  var cleanTransformArray = ee.List([10, 0, xOrigin, 0, -10, yOrigin]);
 
  var local10mProjection = ee.Projection({
    crs: utmEpsg,
    transform: cleanTransformArray
  });
 
  // ---- 4.9 Exportação
  Export.image.toDrive({
    image: newimage,
    description: "result_" + id + "_PL2",
    folder: "Projeto ICRAF",
    scale: 10,
    region: PROC_AOI,
    maxPixels: 130582360
  });
 
  if (export_anual === true) {
    var list = annualy.toList(annualy.size());
    var count = annualy.size().getInfo();
 
    for (var i = 0; i < count; i++) {
      var img = ee.Image(list.get(i));
      var alignedimage = img.reproject({crs: local10mProjection});
      var year = ee.Number(img.get('year')).getInfo();
      Export.image.toDrive({
        image: alignedimage.toFloat(),
        description: "image_" + id + "_" + year.toString(),
        folder: "Projeto ICRAF",
        region: AOI,
        crs: utmEpsg,
        crsTransform: cleanTransformArray,
        maxPixels: 130582360
      });
    }
  }
 
  print('Tarefa de exportação criada para o polígono id=' + id);
}
 
// =============================================================================
// 5. LOOP por polígono 
// =============================================================================
idList.forEach(function(id) {
  processarPoligono(id);
});
 
